{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "definition",
    "requiredSecrets"
  ],
  "properties": {
    "format": {
      "const": "service-incident-timeline/workflow"
    },
    "formatVersion": {
      "const": 1
    },
    "requiredSecrets": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "nodes",
        "edges"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "start"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "service": {
                        "type": "string",
                        "maxLength": 100,
                        "default": ""
                      },
                      "executionService": {
                        "type": "string",
                        "maxLength": 100,
                        "default": ""
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "end"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "service": {
                        "type": "string",
                        "maxLength": 100,
                        "default": ""
                      },
                      "executionService": {
                        "type": "string",
                        "maxLength": 100,
                        "default": ""
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "cron"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "executionService": {
                        "type": "string",
                        "maxLength": 100,
                        "default": ""
                      },
                      "expression": {
                        "type": "string",
                        "maxLength": 100,
                        "default": ""
                      },
                      "timezone": {
                        "type": "string",
                        "maxLength": 100,
                        "default": "Asia/Seoul"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "service-state"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "service": {
                        "type": "string",
                        "maxLength": 100,
                        "default": ""
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "condition"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "maxLength": 200,
                        "default": ""
                      },
                      "operator": {
                        "type": "string",
                        "maxLength": 30,
                        "default": "equals"
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 2000,
                        "default": ""
                      },
                      "valueSource": {
                        "type": "string",
                        "maxLength": 10,
                        "default": "literal"
                      },
                      "rules": {
                        "type": "string",
                        "maxLength": 16000,
                        "default": ""
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "find"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "source": {
                        "type": "string",
                        "maxLength": 200,
                        "default": "response.body"
                      },
                      "field": {
                        "type": "string",
                        "maxLength": 200,
                        "default": "id"
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 2000,
                        "default": ""
                      },
                      "valueSource": {
                        "type": "string",
                        "maxLength": 10,
                        "default": "literal"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "datetime"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "source": {
                        "type": "string",
                        "maxLength": 200,
                        "default": "now"
                      },
                      "timezone": {
                        "type": "string",
                        "maxLength": 100,
                        "default": "Asia/Seoul"
                      },
                      "format": {
                        "type": "string",
                        "maxLength": 20,
                        "default": "iso"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "http"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "method": {
                        "type": "string",
                        "maxLength": 10,
                        "default": "GET"
                      },
                      "url": {
                        "type": "string",
                        "maxLength": 2000,
                        "default": ""
                      },
                      "headers": {
                        "type": "string",
                        "maxLength": 16000,
                        "default": "{}"
                      },
                      "body": {
                        "type": "string",
                        "maxLength": 64000,
                        "default": ""
                      },
                      "onError": {
                        "type": "string",
                        "maxLength": 20,
                        "default": "stop"
                      },
                      "intent": {
                        "type": "string",
                        "maxLength": 10,
                        "default": "auto"
                      },
                      "outputMode": {
                        "type": "string",
                        "maxLength": 10,
                        "default": "summary"
                      },
                      "outputPaths": {
                        "type": "string",
                        "maxLength": 2000,
                        "default": ""
                      },
                      "idempotency": {
                        "type": "string",
                        "maxLength": 10,
                        "default": "none"
                      },
                      "timeoutMs": {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 30000,
                        "default": 10000
                      },
                      "retries": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3,
                        "default": 0
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                  },
                  "type": {
                    "const": "finish"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "result": {
                        "type": "string",
                        "maxLength": 20,
                        "default": "success"
                      },
                      "message": {
                        "type": "string",
                        "maxLength": 2000,
                        "default": ""
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to",
              "port"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "from": {
                "type": "string",
                "maxLength": 80
              },
              "to": {
                "type": "string",
                "maxLength": 80
              },
              "port": {
                "enum": [
                  "next",
                  "true",
                  "false",
                  "error",
                  "zero",
                  "one",
                  "many"
                ]
              }
            }
          }
        }
      }
    }
  }
}
